VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Development-only admin preview. Ignored in production builds.
VITE_ENABLE_ADMIN_PREVIEW=false

# Customer portal API contracts. Leave blank until the FastAPI paths are agreed.
# Every request sends the Firebase ID token; the backend must verify ownership.
VITE_CUSTOMER_OVERVIEW_ENDPOINT=
VITE_CUSTOMER_SUBSCRIPTIONS_ENDPOINT=
VITE_CUSTOMER_INVOICES_ENDPOINT=
VITE_CUSTOMER_PROFILE_ENDPOINT=/api/auth/me
VITE_CUSTOMER_UPDATE_PROFILE_ENDPOINT=
